{
	"name": "ayacoo/news-tldr",
	"version": "2.0.1",
	"type": "typo3-cms-extension",
	"description": "Creates a short summary for news via ChatGPT",
	"homepage": "https://www.ayacoo.de",
	"authors": [
		{
			"name": "Guido Schmechel",
			"role": "Developer"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"require": {
		"php": ">=8.2 < 8.6",
		"typo3/cms-core": "^13.4",
		"georgringer/news": "^12.0 || ^13.0 || ^14.0",
		"openai-php/client": "*"
	},
	"autoload": {
		"psr-4": {
			"Ayacoo\\NewsTldr\\": "Classes/"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true,
			"php-http/discovery": true
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "news_tldr",
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"web-dir": ".Build/Web"
		}
	}
}
